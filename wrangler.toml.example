name = "wasa-store-api"
main = "worker.js"
compatibility_date = "2026-11-25"

[[d1_databases]]
binding = "DB"
database_name = "wasa-kasur-db"
database_id = "PASTE_YOUR_D1_DATABASE_ID"

[[r2_buckets]]
binding = "BUCKET"
bucket_name = "WASA Store"

[vars]
ALLOWED_ORIGIN = "https://smartcear.github.io"
