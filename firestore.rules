rules_version = '2';
// LEGACY NOTE: the app still uses custom phone/password sessions instead of
// Firebase Authentication. Firestore cannot identify the logged-in role here.
// These rules preserve the existing permissive behavior and are NOT secure for
// production. Migrate to Firebase Auth + role-based rules before sensitive use.
service cloud.firestore {
  match /databases/{database}/documents {
    match /wasaSignupLocks/{id} { allow read, write: if true; }
    match /wasaProfileRequests/{id} { allow read, write: if true; }
    match /wasaUsers/{id} { allow read, write: if true; }
    match /wasaSettings/{id} { allow read, write: if true; }
    match /wasaActivityTypes/{id} { allow read, write: if true; }
    match /wasaActivities/{id} { allow read, write: if true; }
    match /wasaBulkData/{id} { allow read, write: if true; }
    match /wasaConsumerMeta/{id} { allow read, write: if true; }
    match /wasaConsumerChunks/{id} { allow read, write: if true; }
    match /wasaCorrections/{id} { allow read, write: if true; }
    match /wasaDuplicates/{id} { allow read, write: if true; }
    match /wasaPasswordResets/{id} { allow read, write: if true; }
    match /wasaNotifications/{id} { allow read, write: if true; }
    match /wasaAudit/{id} { allow read, write: if true; }
    match /wasaLiveTrack/{id} { allow read, write: if true; }
    match /wasaTargets/{id} { allow read, write: if true; }
    match /wasaMessages/{id} { allow read, write: if true; }
    match /wasaBoundaries/{id} { allow read, write: if true; }
    match /wasaTrackPoints/{id} { allow read, write: if true; }
    match /wasaTrackEvents/{id} { allow read, write: if true; }
  }
}
